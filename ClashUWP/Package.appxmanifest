<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <!--
    ⚠️ 改这个文件之前先读这段。这里有两条曾经判断错、后来被部署实测纠正过的事实。

    【事实 1】<Application> 的 Executable + EntryPoint 直接激活托管类型 —— 这条成立。
      本项目是 net10-windows10.0.26100 + UseUwp（CoreCLR，不是 .NET Native）：
      SDK 生成的清单里就是 <Application Executable="ClashUWP.exe" EntryPoint="ClashUWP.App">，
      输出目录里确实没有 CLRHost.dll。
      但这条结论<b>只适用于前台 Application</b>，不能外推到后台任务。

    【事实 2】后台任务<b>仍然需要</b> activatableClass.inProcessServer 声明 —— 早期判断错了。
      平台侧是纯清单驱动的：读 ActivatableClassId + Path，LoadLibrary(Path)，
      再 GetProcAddress("DllGetActivationFactory")。它不查 winmd，也不认识托管 exe。
      实测把 VpnBackgroundTask 留在应用 exe 工程里，部署直接报：
          0x80080204 「如果不是音频后台任务，则不允许在
          windows.activatableClass.inProcessServer 中没有 ActivatableClassId 的情况下，
          令 EntryPoint="ClashUWP.Vpn.VpnBackgroundTask"」
      根因：exe 工程不产出 winmd，平台找不到可激活类。

      → 正确形态见文件末尾 <Extensions>（Package 级）：
        后台任务类必须放在 CsWinRTComponent 工程（ClashUWP.Vpn）里。
        该工程以「自包含组件」模式构建（PublishAot + NativeLib=Shared），再由主工程
        CsWinRTMergeReferencedActivationFactories=true 合并进主模块 ClashUWP.dll，
        所以 Path 填 ClashUWP.dll；不需要 WinRT.Host.dll 宿主（托管组件模式才需要）。
  -->

  <Identity
    Name="421769c5-17f4-4287-b6c1-193222d21e14"
    Publisher="CN=gold"
    Version="1.0.68.0" />

  <mp:PhoneIdentity PhoneProductId="421769c5-17f4-4287-b6c1-193222d21e14" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>ClashUWP</DisplayName>
    <PublisherDisplayName>gold</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <!--
      前台 UI（Reactor.Uwp）。

      ★ windows.appService 扩展 = in-app AppService（clashuwp-cli 的连接点）：
        · <b>不写 EntryPoint</b> —— 这正是要的形态。官方规则：Application 级
          appService 扩展带 EntryPoint 时走独立后台任务宿主；不带时连接激活
          的是<b>本前台进程</b>的 App.OnBackgroundActivated(AppServiceTriggerDetails)，
          遥控的才是 VpnSession/健康哨兵/DebugCommandLoop 真实状态所在的那个进程。
          （background-task AppService 会起空壳宿主，看不到主进程内存 —— 选错
            形态整个通道就白做。）
        · 与上方 Plugin 的 backgroundTasks 不同，这里<b>不需要</b>
          Package 级 activatableClass.inProcessServer 注册 —— 那条"事实 2"
          只约束后台任务激活；in-app AppService 由前台进程自己接收，没有
          独立的 WinRT 类要平台去 LoadLibrary。
        · Name 必须与 CLI 侧 AppServiceConnection.AppServiceName 逐字一致：
          "ClashUWP.Debug"（见 ClashUWP.Cli/Program.cs）。
    -->
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="ClashUWP.App">
      <uap:VisualElements
        DisplayName="ClashUWP"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="ClashUWP"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.appService">
          <uap:AppService Name="ClashUWP.Debug" />
        </uap:Extension>
        <!--
          ★【1.0.53】协议激活：浏览器"一键导入 Clash 订阅"的入口。
          【为什么要注册两条】
            · clashuwp:// —— 自己的协议，不会被别的客户端抢；
            · clash:// —— Clash 系客户端（Verge / CFW / ClashX）的通用协议，
              **机场面板上那个"一键导入 Clash"按钮点的就是它**
              （形如 clash://install-config?url=<订阅链接>）。
              ⇒ 注册它就能直接接住机场现成的按钮，不用用户先复制再切窗口粘贴。
          【★ 同名协议多客户端时会怎样】Windows 按 PFN 弹出"要用哪个应用打开"的选择器，
            用户选一次 ClashUWP 即可（之后还能在设置里改默认）。这正是想要的行为 ——
            本机已装着 clash-verge，它同样注册 clash://。
          【★ 安全边界（必须收窄）】协议参数会带一个完整 URL，
            而 <see cref="SubscriptionManager.FetchAsync"/> 会往它发请求。
            ① 只认 http/https（file:// / ms-appx:// / 本地路径一律拒）；
            ② 不落地任何"静默导入"——导入前 UI 上必须能看到 URL 原文，
               用户点「拉取并启用」才真正发请求（见 MainComponent.FetchSubscriptionAsync）；
            ③ <b>不</b>在协议激活时自动连接 VPN。
        -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="clashuwp">
            <uap:DisplayName>ClashUWP</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="clash">
            <uap:DisplayName>ClashUWP (Clash 订阅)</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>

    <!--
      VPN 插件宿主。★ 单独一个 Application = 单独进程。
      【官方 sample 清单内注释】："keep them running in two separate processes, so if one
      is closed, it won't terminate the other"
      → 关掉前台 UI 不会把隧道一起带走。

      AppListEntry="none"：不出现在开始菜单 / 应用列表（它只是宿主，没有 UI）。
      ★ 位置很关键：它是 <uap:VisualElements> 的属性，不是 <Application> 的属性。
      挂在 <Application> 上部署会直接失败：
        0xC00CE015 未在 DTD/架构中定义元素 '{...}Application' 的属性 '{...uap...}AppListEntry'
      （实测踩过一次，见 AppXDeploymentServer/Operational 事件 404）

      注意 Application 本身不写 Executable / EntryPoint —— 官方 sample 两个版本
      （CSharp / CppWinRT）的 Plugin Application 都没有，激活信息由 <Extension> 提供。

      <uap:Task Type="vpnClient" />：声明本包提供 VPN 客户端插件。
      【官方 sample 注释】："When your application is installed this background task will
      automatically be registered by the VPN platform."
      → 装包即注册，<b>不需要</b>自己 BackgroundTaskBuilder.Register。
    -->
    <Application Id="Plugin">
      <uap:VisualElements
        DisplayName="ClashUWP"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="ClashUWP VPN Plugin"
        BackgroundColor="transparent"
        AppListEntry="none">
        <uap:DefaultTile/>
      </uap:VisualElements>
      <Extensions>
        <Extension Category="windows.backgroundTasks"
          Executable="$targetnametoken$.exe"
          EntryPoint="ClashUWP.Vpn.VpnBackgroundTask">
          <BackgroundTasks>
            <uap:Task Type="vpnClient" />
          </BackgroundTasks>
        </Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- DatagramSocket 绑本地端口需要 internetClientServer；访问局域网段需要 privateNetworkClientServer -->
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />

    <!--
      ★ 受限能力（restricted capability）：Windows.Networking.Vpn 全家族的前提。
      【官方】VpnChannel / IVpnPlugIn / VpnManagementAgent / VpnPlugInProfile 的
      Windows requirements 均列 *App capabilities: networkingVpnProvider*。

      上架需微软审批（sample README："The VPN apps in Windows are curated"），
      侧载 / 自签部署不受此限。
    -->
    <rescap:Capability Name="networkingVpnProvider" />
  </Capabilities>

  <!--
    ★ Package 级的 <Extensions> —— 与 <Applications> / <Capabilities> 平级，
      <b>不是</b> <Application> 下的那个 <Extensions>。放错位置平台一样找不到。

    这是后台任务能被 WinRT 激活的注册点：
      · ActivatableClassId 必须与上面 <uap:Task Type="vpnClient"/> 那条
        Extension 的 EntryPoint <b>逐字相同</b>；
      · Path 是宿主模块。本项目走「全 AOT + merge」形态：主工程开了
        CsWinRTMergeReferencedActivationFactories=true，被引用的组件 ClashUWP.Vpn
        被合并进主工程自己的 native 模块，由该模块统一导出 DllGetActivationFactory
        并转发激活调用。OutputType=WinExe 下 CsWinRT 把主工程 native 产物切成
        共享库 ClashUWP.dll（另配极小 ClashUWP.exe 桩），所以这里填 ClashUWP.dll。
        （托管组件形态填 WinRT.Host.dll；组件 AOT 自包含但不合并时填 ClashUWP.Vpn.dll；
          更老的 .NET Native 填 CLRHost.dll。）
      · ThreadingModel="both"：VpnChannel.ProcessEventAsync 的回调线程不保证。

    ★ 打包要求：msix 里必须有 ClashUWP.dll（原生，导出 DllGetActivationFactory，
      内含 VpnBackgroundTask 激活工厂）+ 旁边的 ClashUWP.exe 桩。
      全 AOT 合并后不再需要 ClashUWP.Vpn.dll / WinRT.Host.* / WinRT.Runtime.dll。
  -->
  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>ClashUWP.dll</Path>
        <ActivatableClass ActivatableClassId="ClashUWP.Vpn.VpnBackgroundTask" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>
</Package>
