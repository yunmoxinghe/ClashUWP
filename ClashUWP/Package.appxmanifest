<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <!--
    ⚠️ 改这个文件之前先读这段。这里的事实有被部署实测纠正过的，也有被现读源码纠正过的。

    【事实 1】<Application> 的 Executable + EntryPoint 直接激活托管类型 —— 这条成立。
      本项目是 net10-windows10.0.26100 + UseUwp（CoreCLR / NativeAOT，不是 .NET Native）：
      SDK 生成的清单里就是 <Application Executable="ClashUWP.exe" EntryPoint="ClashUWP.App">，
      输出目录里确实没有 CLRHost.dll。
      ★ 全 AOT 下前台进程是 ClashUWP.exe 桩跳 __managed__Main（手写 Main），
        平台并不按 EntryPoint 字符串反射托管类型，所以 App 转 internal 不影响启动。

    【事实 2】后台任务<b>仍然需要</b> activatableClass.inProcessServer 声明 —— 早期判断错过一次。
      平台侧是纯清单驱动的：读 ActivatableClassId + Path，LoadLibrary(Path)，
      再 GetProcAddress("DllGetActivationFactory")。它不查 winmd，也不认识托管 exe。
      当年把 VpnBackgroundTask 留在应用 exe 工程里，部署直接报：
          0x80080204 「如果不是音频后台任务，则不允许在
          windows.activatableClass.inProcessServer 中没有 ActivatableClassId 的情况下，
          令 EntryPoint="ClashUWP.Vpn.VpnBackgroundTask"」

    【事实 2 的根因更正（1.0.76 现读 CsWinRT 2.3.1 源码）】
      当时归因给"exe 工程不产出 winmd，所以必须拆组件"——<b>这条归因只对了一半</b>：
      真正的门槛在 CsWinRT 生成器里：
          Generator.cs: if (!IsCsWinRTComponent() && !ShouldGenerateWinMDOnly()) return;
      即"非组件形态的工程不注册自己的激活工厂"。而 targets 是按属性无条件
      import Authoring.targets 的，对 OutputType 没有门禁 ⇒ 主工程自己写
      CsWinRTComponent=true 就能合法产出 winmd + 导出 DllGetActivationFactory。
      ⇒ 1.0.76 起插件类 VpnBackgroundTask 就住在本工程（ClashUWP\Vpn\，命名空间不变），
        清单只剩一个 Application，第二个（无头）入口和 AppListEntry="none" 那套豁免问题一起消失。

      → 两个必要条件（缺一部署就回到 0x80080204 / 0x8007007E）：
        ① 工程侧 CsWinRTComponent=true（产出 winmd 并导出激活工厂）；
        ② 文件末尾 Package 级 <Extensions> 的 inProcessServer 注册（Path=ClashUWP.dll）。
        模块形态（native 产物切成共享库 ClashUWP.dll + 极小 exe 桩）仍由
        CsWinRTMergeReferencedActivationFactories=true 触发，那行属性不能删，理由见 csproj 注释。
  -->

  <Identity
    Name="8B8CC4F4.ClashUWP"
    Publisher="CN=A19C62A9-1AA6-44AB-9F57-2DE6C380D9C9"
    Version="1.0.127.0" />

  <mp:PhoneIdentity PhoneProductId="e5bd739e-05a5-4a61-a7ab-2b5d1da1de4e" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>ClashUWP</DisplayName>
    <PublisherDisplayName>云漠星</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- ★【1.0.102 · Docs/53】这里曾经跟着多实例实验把 MinVersion 提到 10.0.14393.0、
         MaxVersionTested 提到 10.0.26100.0（uap10 属性是 1607 引入的，MinVersion 停在
         10.0.0.0 会让"属性被拒还是被 ignorable 吃掉"多出一个说不清的变量）。
         多实例那条杠杆已被部署期两条 0x80080204 判死（见上方【进程隔离的实测依据】末尾），
         ⇒ 这两行原样撤回，保持与已提交认证的商店包逐字同一形态。 -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <!--
      前台 UI（Reactor.Uwp）。

      ★【Docs/47 建档】清单声明、本包进程/实例模型、SupportsMultipleInstances 三个同名
        属性的分工、无头应用豁免、以及"要不要开多实例"这五件事的<b>唯一数据源是 Docs/47</b>，
        口径以它为准；本文件往下的注释只留一手实测原文，不再承担定义职责。
        其中那条决定先记在这儿备查：主应用<b>不开</b> SupportsMultipleInstances，
        因为 appService 与 vpnClient 任务都是 in-proc 形态，而官方口径是
        "进程内后台任务不支持多实例"（AppService 那条同样不支持，出处与置信度见 Docs/47 §四 T2）。

      ★ windows.appService 扩展 = in-app AppService（clashuwp-cli 的连接点）：
        · <b>不写 EntryPoint</b> —— 这正是要的形态。官方规则：Application 级
          appService 扩展带 EntryPoint 时走独立后台任务宿主；不带时连接激活
          的是<b>本前台进程</b>的 App.OnBackgroundActivated(AppServiceTriggerDetails)，
          遥控的才是 VpnSession/健康哨兵/DebugCommandLoop 真实状态所在的那个进程。
          （background-task AppService 会起空壳宿主，看不到主进程内存 —— 选错
            形态整个通道就白做。）
        · 与下方 backgroundTasks 不同，appService <b>不需要</b>
          Package 级 activatableClass.inProcessServer 注册 —— 那条"事实 2"
          只约束后台任务激活；in-app AppService 由前台进程自己接收，没有
          独立的 WinRT 类要平台去 LoadLibrary。
        · Name 必须与 CLI 侧 AppServiceConnection.AppServiceName 逐字一致：
          "ClashUWP.Debug"（见 ClashUWP.Cli/Program.cs）。

      ★【1.0.76】windows.backgroundTasks 与 vpnClient 任务：以前挂在第二个
        <Application Id="Plugin"> 上，现在合并到这一个入口下。
        · 官方 sample 之所以拆两个 Application，是为了<b>进程隔离</b>
          （"keep them running in two separate processes, so if one is closed,
            it won't terminate the other"）。合并后这一条的依据换了，见下方
          【进程隔离的实测依据】—— 注册形态已核，"关前台会不会带走隧道"仍待拨号验证。
        · 拆成第二个 Application 的代价才是真的：它没有 UI，只能靠
          AppListEntry="none" 隐藏，而那个属性触发「无权创建无头应用」
          （1.0.72 就是因此被迫放弃隐藏，见 Docs/25）。
          ★【2026-10-23 订正：这一句要分两维读，原文留着作记账】
          1.0.72 那次把「缺 Executable / EntryPoint（真因，报 MakeAppx 80080204）」和
          「删掉 AppListEntry=none」一起改了，从没拆开验过。臂 C（1.0.106）这个入口
          三样齐全、带 AppListEntry=none，本地打包与注册一次通过，开始菜单仍只一条。
          ★ 但<b>商店那一维仍然拦</b>：第三方两家一手写明，次级入口带 AppListEntry=none
          会被 Store 包验收拒，除非开发者账号已拿到账号级 HeadlessAppBypass 豁免
          （scottlerch/HostsFileEditor 撞的就是「主入口可见 + 第二个想隐藏」这个同形状，
          他最后的处理是放弃隐藏；pierreaubert/sotf 同口径）。它不是清单里可声明的能力，
          是打在账号上的标记，只能走 Partner Center 工单。
           ⇒ 上架前二选一：删本入口的 AppListEntry 属性（开始菜单多一条插件宿主，
          臂 C 的隔离与修复不依赖隐藏；⚠️ 删完的隔离性未装机复验），或申请账号级豁免。
          证据表与判据边界在 Docs/47 第四节 T16/T17、第五节丙、第七节第 7/7b 条。
        · <uap:Task Type="vpnClient" />：装包即由 VPN 平台自动注册，
          <b>不需要</b>自己 BackgroundTaskBuilder.Register（官方 sample 注释）。
        · Extension 上的 Executable / EntryPoint 才是激活信息来源，
          EntryPoint 必须与 Package 级 ActivatableClassId <b>逐字相同</b>。

      【进程隔离的实测依据（1.0.77 真拨号取证，Docs/31 §4.3）】
        插件宿主由 VPN 平台（RasMan / svchost）按 Package 级 inProcessServer
        LoadLibrary 拉起，与入口数量无关。装机后注册表给出的<b>形态</b>证据：
          HKCU\Software\Classes\Extensions\ContractId\Windows.BackgroundTasks\
          PackageId\8B8CC4F4.ClashUWP_1.0.76.0_x64__4tjvwvefxrz66\ActivatableClassId
          下面挂着<b>三个不同的 App.AppX&lt;hash&gt;.mca</b>（CustomProperties 的
          Capabilities 掩码各不相同）。
        ★ 但"三个 mca 身份"只等于"平台可以分开激活"，<b>不等于运行时必然分进程</b>。
          实测：前台在跑时 vpnClient 激活被单实例语义路由进<b>同一个 pid</b>（插件日志与
          app 日志同为前台 pid）；关掉前台窗口后平台先 Canceled 旧会话，再<b>另起一个后台
          宿主进程</b>重拨，隧道自己回来 —— 所以"关掉界面隧道仍在"成立，
          代价是一次约 2s 的平台重拨间隙。
        ⇒ 旧判词（1.0.77~1.0.101，Docs/31 §4.3 / Docs/29 R6 / Docs/47 §一）是
          "不要为此上 uap10:SupportsMultipleInstances"。
        ★★【1.0.102 · Docs/53 这条判词由推升为实测，两臂都在<b>部署期</b>就被拒】
          用户要求修掉那次 2 s 间隙 ⇒ 现读现试，两条臂各撞一条硬约束：
            臂 A：Application 上写 uap10:SupportsMultipleInstances="true"、
                  下面 bgtask Extension 照写 Executable
                  ⇒ AppxManifest.xml(<b>142</b>,10) 0x80080204
                    「在 SupportsMultipleInstances 为 true 时无法指定可执行文件」
                    （142 行第 10 列 = 那个 Extension 的 Executable 属性）。
            臂 B：保留多实例、把 Executable 删掉只留 EntryPoint
                  ⇒ AppxManifest.xml(<b>150</b>,10) 0x80080204
                    「因为此类型的任务需要自定义后台任务宿主」。
          ⇒ 两条互斥，<b>vpnClient 的自定义宿主声明与多实例不能共存</b>，
            这条杠杆对本包是<b>封死</b>的（不是"没试"了）。要真正消除这次间隙只剩两条路，
            都不在本批：① 把插件拆成<b>独立的 VPN 插件包</b>（官方两包模型，
            方向与 Docs/29 那次"插件回收进主工程"相反，且商店提交材料要重做）；
            ② 关窗后让 UI 进程不死（UWP XAML 窗口没有可拦截的 Closing API，
            多视图隐藏窗口那条属于未证实且商店政策敏感的旁门）。
          判据存档：两条 ActivityId 在 Docs/53，报错来自注册期，未装机、未拨号，
          对整机网络零影响。
    -->
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="ClashUWP.App">
      <uap:VisualElements
        DisplayName="ClashUWP"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="ClashUWP"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.appService">
          <uap:AppService Name="ClashUWP.Debug" />
        </uap:Extension>
        <!-- VPN 插件后台任务的声明【1.0.106 起挪到下面第二个 Application 入口 VpnHost】。
          【为什么挪】★【Docs/53 臂 C】臂 A/臂 B 都在注册期被 0x80080204 拒掉（原文见上面
          那段存档），剩下同一包里唯一没试过的杠杆就是<b>入口身份</b>：
          单实例 ⇒ 这个 Extension 挂在 UI 入口 App 上时，vpnClient 的宿主就是 App 的进程，
          关窗 reclaim 掉那个进程 ⇒ 平台 Canceled ⇒ 无头宿主重拨 ⇒ 约 2s 整机断流。
          把它挂到另一个 Application 入口（AppListEntry=none、不摆开始菜单），
          赌的是"后台任务宿主按入口分进程"。
          ★【1.0.106 装机已证：赌对】⇒ 那 2s 断流从此消失，证据在 Docs/53 §五。
          【Executable 这一行不能删】1.0.102 臂 B 实测：删掉只留 EntryPoint ⇒
          AppxManifest.xml(150,10) 0x80080204「因为此类型的任务需要自定义后台任务宿主」。 -->
        <!--
          ★【1.0.53】协议激活：浏览器"一键导入 Clash 订阅"的入口。
          【为什么要注册两条】
            · clashuwp:// —— 自己的协议，不会被别的客户端抢；
            · clash:// —— Clash 系客户端（Verge / CFW / ClashX）的通用协议，
              **机场面板上那个"一键导入 Clash"按钮点的就是它**
              （形如 clash://install-config?url=<订阅链接>）。
              ⇒ 注册它就能直接接住机场现成的按钮，不用用户先复制再切窗口粘贴。
          【★ 同名协议多客户端时会怎样】Windows 按 PFN 弹出"要用哪个应用打开"的选择器，
            用户选一次 ClashUWP 即可（之后还能在设置里改默认）。这正是想要的行为 ——
            本机已装着 clash-verge，它同样注册 clash://。
          【★ 安全边界（必须收窄）】协议参数会带一个完整 URL，
            而 <see cref="SubscriptionManager.FetchAsync"/> 会往它发请求。
            ① 只认 http/https（file:// / ms-appx:// / 本地路径一律拒）；
            ② 不落地任何"静默导入"——导入前 UI 上必须能看到 URL 原文，
               用户点「拉取并启用」才真正发请求（见 MainComponent.FetchSubscriptionAsync）；
            ③ <b>不</b>在协议激活时自动连接 VPN。
        -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="clashuwp">
            <uap:DisplayName>ClashUWP</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="clash">
            <uap:DisplayName>ClashUWP (Clash 订阅)</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>

    <!--
      ★★【1.0.106 · Docs/53 臂 C】vpnClient 后台任务的宿主从上面那个 UI 入口挪到这一个<b>独立入口</b>。
      【要验的那一件事】上面 App 入口那段存档已经写死：同一个包里，
      "多实例"与"进程内 vpnClient 任务"不能共存（0x80080204 两条互斥），
      而单实例 ⇒ 关窗 reclaim 掉 UI 进程 ⇒ 平台 Canceled ⇒ 无头宿主重拨 ⇒ 约 2s 整机断流。
      于是同包内只剩这一根杠杆没试：<b>入口身份</b> ——
      后台任务的宿主进程是按 Application 入口分配的，把任务挂到一个不摆开始菜单
      （AppListEntry=none）、也从不作为前台应用启动的第二个入口上，
      UI 进程的生死就不该再牵连宿主。赌的就是这一句。
      【判据（装机才有效）】拨号后比对两个 pid：界面进程 与 plugin.log 里
      <c>bgtask 插件进程启动 … pid=</c> 那个。两个不同 ⇒ 赌对；同一个 ⇒ 平台仍按包族合并宿主，
      本包无解，只能走"插件拆独立包"那条（Docs/53 §三）。
      ★★【1.0.106 装机实测：赌对，本条判据已闭合】注册没被拒（臂 A/臂 B 的 0x80080204 没有再现），
      装机后拨号：界面 pid=9488、宿主 pid=6368 <b>两个不同进程</b>；
      07:41:25 关掉窗口 reclaim 掉 9488，6368 与隧道接口原样活着，
      心跳 alive 严格 +13s 连续越过关窗时刻（117s → 130s），会话一路到用户主动断开（存活 276s）。
      细则与长跑证据在 Docs/53 §五。
      【为什么 EntryPoint 仍填 ClashUWP.App】这一入口永远不会被前台启动，
      填成和 UI 一样的应用类是为了让宿主进程里的运行时/激活行为与今天<b>逐字相同</b>，
      本实验只改"入口身份"这一个变量。
    -->
    <Application Id="VpnHost"
      Executable="$targetnametoken$.exe"
      EntryPoint="ClashUWP.App">
      <uap:VisualElements
        DisplayName="ClashUWP VPN 插件宿主"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="ClashUWP 的 VPN 插件宿主入口（不对用户开放）"
        BackgroundColor="transparent"
        AppListEntry="none">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <Extension Category="windows.backgroundTasks"
          Executable="$targetnametoken$.exe"
          EntryPoint="ClashUWP.Vpn.VpnBackgroundTask">
          <BackgroundTasks>
            <uap:Task Type="vpnClient" />
          </BackgroundTasks>
        </Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- DatagramSocket 绑本地端口需要 internetClientServer；访问局域网段需要 privateNetworkClientServer -->
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />

    <!--
      ★ 受限能力（restricted capability）：Windows.Networking.Vpn 全家族的前提。
      【官方】VpnChannel / IVpnPlugIn / VpnManagementAgent / VpnPlugInProfile 的
      Windows requirements 均列 *App capabilities: networkingVpnProvider*。

    ★【1.0.76 更正】这段与"协议激活/商店审批"的口径：
      受限能力<b>不再需要提前联系微软</b>。现在官方流程是：上传包时平台检测到清单里
      声明了受限能力，就要求你在 Partner Center 的 Submission options →
      Restricted capabilities 页填写"怎么用、为什么必须"，认证人员据此判定；
      批了才继续走后续认证，后续更新一般不用重复申请（除非新增能力）。
      侧载 / 自签部署不受此限（官方原文：Store approval isn't required to sideload）。
      networkingVpnProvider 在受限能力表里<b>没有</b>"不建议声明 / 多数情况不批"那句
      附加语（有那句的是 userPrincipalName、screenDuplication、walletSystem 那几个）。
    -->
    <rescap:Capability Name="networkingVpnProvider" />
  </Capabilities>

  <!--
    ★ Package 级的 <Extensions> —— 与 <Applications> / <Capabilities> 平级，
      <b>不是</b> <Application> 下的那个 <Extensions>。放错位置平台一样找不到。

    这是后台任务能被 WinRT 激活的注册点：
      · ActivatableClassId 必须与上面 <uap:Task Type="vpnClient"/> 那条
        Extension 的 EntryPoint <b>逐字相同</b>；1.0.76 合并工程后这个字符串没变，
        因为 VpnBackgroundTask 的命名空间保持 ClashUWP.Vpn（文件搬到 ClashUWP\Vpn\ 而已）。
      · Path 是宿主模块。本项目走「全 AOT + 单模块」形态：本工程自己就是 CsWinRT
        授权组件（CsWinRTComponent=true），native 产物由 CsWinRTMergeReferencedActivationFactories
        触发切成共享库 ClashUWP.dll（另配极小 ClashUWP.exe 桩），
        由该模块导出 DllGetActivationFactory，所以这里填 ClashUWP.dll。
        （托管组件形态填 WinRT.Host.dll；更老的 .NET Native 填 CLRHost.dll。）
      · ThreadingModel="both"：VpnChannel.ProcessEventAsync 的回调线程不保证。

    ★ 打包要求：msix 里必须有 ClashUWP.dll（原生，导出 DllGetActivationFactory，
      内含 VpnBackgroundTask 激活工厂）+ 旁边的 ClashUWP.exe 桩。
      全 AOT 单模块后不需要 ClashUWP.Vpn.dll / WinRT.Host.* / WinRT.Runtime.dll；
      授权过程生成的 ClashUWP.winmd 只落在 obj/bin，<b>不该</b>出现在包里。
  -->
  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>ClashUWP.dll</Path>
        <ActivatableClass ActivatableClassId="ClashUWP.Vpn.VpnBackgroundTask" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>
</Package>
