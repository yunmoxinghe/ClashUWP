<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <!-- Reactor.Uwp 只做 x64 / arm64：原生桥 Reactor.Uwp.Native.dll 只带这两个架构的
         预编译产物，x86 会缺 DLL（框架会回退自绘虚拟化，但没必要留这个坑）。 -->
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- CsWinRT1030：VpnChannel.Start 要传 IVector<HostName>（List<HostName>），
         泛型 WinRT 接口跨 ABI 需要生成的 unsafe 代码，AOT 下必须开。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 组件 ClashUWP.Vpn 已 AOT 成原生 dll，主工程拿不到它的托管类型；
         这里指定从组件 winmd 生成 VpnPluginConfig 的 C# 投影，
         供 VpnProfileSetup 序列化自定义 XML（前台与插件之间的配置契约）。 -->
    <CsWinRTIncludes>ClashUWP.Vpn</CsWinRTIncludes>

    <!--
      ★ 两边都 AOT 的关键开关（CsWinRT 官方属性）：
        让 AOT 场景下 native DllGetActivationFactory 把激活调用转发给被引用的 WinRT
        组件，从而把组件与主工程合并进同一个 native 模块。

      为什么必须开：组件 AOT 后不再单独产出 ClashUWP.Vpn.dll；若主模块不导出/转发
      激活工厂，平台按清单 Path 去 LoadLibrary 会 0x8007007E。开此开关后主工程自己
      native 模块也导出 DllGetActivationFactory 并转发给组件。

      ★ 副作用（CsWinRT 自动处理）：OutputType=WinExe 时它把 NativeLib 置为 Shared +
        CustomNativeMain=true，native 主模块变成 ClashUWP.dll，另生成极小 ClashUWP.exe
        桩（wmain 跳 __managed__Main）。清单 Executable 仍是 ClashUWP.exe，
        但 inProcessServer 的 Path 必须填 ClashUWP.dll。
    -->
    <CsWinRTMergeReferencedActivationFactories>true</CsWinRTMergeReferencedActivationFactories>

    <!--
      ★ 签名 + 单项目 MSIX 打包（等价 VS 里「项目 → 生成/发布 → 创建应用包」写入的项）。
      manifest 的 Publisher=CN=gold，这里指定同名自签证书与其指纹完成签名。
      ★ AOT 打包两个坑（已用下方 IncludePublishItemsOutputGroup=true 一并解决）：
        1) BuildTools.MSIX 只会在 GenerateAppxPackageOnBuild=true 时自动收集 AOT
           发布产物；走 PublishAppxPackage 路线必须显式开 IncludePublishItemsOutputGroup，
           否则包内装的是 CoreCLR 构建产物而非 AOT 原生产物。
        2) 开了 IncludePublishItemsOutputGroup 后，ClashUWP.exe 入口桩由发布产物
           （ResolvedFileToPublish）正确提供，无需再手工补 apphost。 -->
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>ClashUWP_TemporaryKey.pfx</PackageCertificateKeyFile>
    <PackageCertificateThumbprint>EDF4E8E0A70864E1F82376012ADE32DAD509DE9F</PackageCertificateThumbprint>
    <!-- 让 `msbuild -t:Publish`（走 pubxml 的 RID/SelfContained 出 AOT 产物）之后
         追加生成签名 MSIX。等价 VS「创建应用包」在 Publish 阶段产出包。 -->
    <PublishAppxPackage>true</PublishAppxPackage>
    <!-- ★ AOT 打包关键：BuildTools.MSIX 里 IncludePublishItemsOutputGroup 只在
         GenerateAppxPackageOnBuild=true 时自动置 true；我们走 PublishAppxPackage（Publish
         之后打包）路线它不会自动开，导致包内装的是 CoreCLR 构建产物而非 AOT 原生产物。
         这里显式置 true，让 GetPackagingOutputs 走 __GetPublishItems 收集 AOT 原生文件，
         并触发 WinAppSdkRemoveLinkedFilesFromPayload 剔除托管运行时。 -->
    <IncludePublishItemsOutputGroup>true</IncludePublishItemsOutputGroup>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Reactor.Uwp" Version="0.1.0-alpha.13" />
    <!-- 消费 ClashUWP.Vpn 这一已 AOT 化的 CsWinRT 组件所需的投影支持：
         组件 AOT 后其 GetTargetPath 是 .winmd，.NET 5+ 直接引用 winmd 会报
         NETSDK1130；本包在构建时从 winmd 生成 C# 投影绕开该错误。 -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>

  <!--
    ★ 组件必须用 PackageReference 消费（本地 feed 见本目录 nuget.config），不能用
      ProjectReference：CsWinRT 在 Authoring.targets 里覆盖了组件工程 GetTargetPath，
      只暴露 .winmd。主工程 AOT 编译因此只拿到 winmd 投影壳、拿不到组件实现 IL，
      CsWinRTMergeReferencedActivationFactories 无对象可合并 → 主模块没有插件代码。
      nupkg 的 lib\...\ClashUWP.Vpn.dll 正是组件实现 IL，作为普通编译引用流进主工程、
      被 AOT 编入主模块，merge 才有对象可转发。

    ★ 组件形态：PublishAot + NativeLib=Shared（见 ClashUWP.Vpn.csproj），CsWinRT 自动置
      CsWinRTAotExportsEnabled=true。合并后主工程自身导出 DllGetActivationFactory，
      清单 inProcessServer 的 Path 填主工程自己的模块 ClashUWP.dll（不是 WinRT.Host.dll）。

    历史教训：不要用 Content 手工把 ClashUWP.Vpn.dll / WinRT.Runtime.dll 塞进包。
  -->
  <ItemGroup>
    <!-- 1.0.7：黑洞主修换轨 —— 建隧道恒走 V2 StartWithTrafficFilter 且
         trafficFilterAssignment 传 null（先遣项目 docs/76 三态单变量 A/B：空对象=默认 deny，
         TCP 直接 WSAEACCES 10013 / ICMP General failure，本地瞬败而非超时；
         V1 Start() 又静默不装 inclusion 路由）。1.0.6 的校验和补齐与采样一并保留。
         ★ 插件源码改了就必须重新 pack 并抬版本号，否则主工程吃的还是旧 nupkg。 -->
    <PackageReference Include="ClashUWP.Vpn" Version="1.0.38" />
  </ItemGroup>

  <!--
    ★ 路线 A 数据面：Go c-shared 原生 DLL（Tools\mihomo-bridge 编译产物）。
      DllImport("clash_bridge") 靠包目录解析，须随 MSIX 打到包根。
      这是原生 DLL，不受「不要用 Content 手工塞托管组件 DLL」那条历史教训约束。
      注意：DLL 为 x64 编译（Go 侧当前只出 x64）；arm64 包暂不包含（见下方 Condition）。
  -->
  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <Content Include="..\Tools\mihomo-bridge\clash_bridge.dll" Link="clash_bridge.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    ★ GEOIP 规则（用户配置如 GEOIP,CN）在 config.Parse 阶段加载 MMDB，缺文件直接
      start 失败（can't download MMDB）。mmdb 与架构无关，无条件打进包根；
      插件侧把 Package.InstalledLocation 作为 mmdbDir 传给 clash_bridge_start。
  -->
  <ItemGroup>
    <Content Include="..\Tools\mihomo-bridge\Country.mmdb" Link="Country.mmdb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>