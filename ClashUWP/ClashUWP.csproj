<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <!-- Reactor.Uwp 只做 x64 / arm64：原生桥 Reactor.Uwp.Native.dll 只带这两个架构的
         预编译产物，x86 会缺 DLL（框架会回退自绘虚拟化，但没必要留这个坑）。 -->
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- CsWinRT1030：VpnChannel.Start 要传 IVector<HostName>（List<HostName>），
         泛型 WinRT 接口跨 ABI 需要生成的 unsafe 代码，AOT 下必须开这个开关。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Reactor.Uwp" Version="0.1.0-alpha.9" />
  </ItemGroup>

  <!--
    ★ ClashUWP.Vpn 这个引用不能省，哪怕前台代码一行都没用到 VpnBackgroundTask。
      它的作用是把 CsWinRT 组件的五件套（ClashUWP.Vpn.winmd、WinRT.Host.dll、
      WinRT.Host.Shim.dll、WinRT.Host.runtimeconfig.json、ClashUWP.Vpn.dll）
      带进本工程的输出/包布局 —— 清单里 inProcessServer 的 Path 指的就是
      WinRT.Host.dll，它不在包里部署必然失败。不要手工拷贝这些文件。

      顺带也是前台拿到 VpnPluginConfig 的途径（VpnProfileSetup 要用它序列化自定义 XML）。
  -->
  <ItemGroup>
    <ProjectReference Include="..\ClashUWP.Vpn\ClashUWP.Vpn.csproj" />
  </ItemGroup>
</Project>