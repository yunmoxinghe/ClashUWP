<Project Sdk="Microsoft.NET.Sdk">
  <!--
    IpPacket 校验和离线夹具（Docs/22 §4.7）。
    ★ 不是产品工程、不在解决方案里：`dotnet run` 即可，用来在改 IpPacket 后
      回归 v4/v6 的校验和与组播判定。直接编译组件源文件，不复制实现 ——
      被测代码与产品逐字同一份。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>IpPacketChecksumTest</AssemblyName>
    <!-- 产物落在 obj/bin 下，与产品构建互不影响。 -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ClashUWP\Vpn\IpPacket.cs" Link="IpPacket.cs" />
  </ItemGroup>
</Project>
