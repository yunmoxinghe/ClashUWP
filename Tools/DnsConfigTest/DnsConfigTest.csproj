<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DnsConfig 离线夹具（Docs/23 §4/§6）。
    ★ 不是产品工程、不在解决方案里：dotnet run 即可。
      直接编译组件的 DnsConfig.cs / LocalSettings.cs / VpnPluginConfig.cs，
      被测代码与产品逐字同一份；WinRT 存储调用只用编译桩（测试从不调用 Load）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DnsConfigTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ClashUWP\Vpn\DnsConfig.cs" Link="DnsConfig.cs" />
    <Compile Include="..\..\ClashUWP\Vpn\LocalSettings.cs" Link="LocalSettings.cs" />
    <!-- ★ 1.0.93 把 settings.txt 的行解析收成共享层 SettingsParse 之后，本 csproj 漏了这条链接
         （YamlShapeTest 同期补了），于是 LocalSettings.cs 里的 CS0103 让这个夹具编译不过。 -->
    <Compile Include="..\..\ClashUWP\Vpn\SettingsParse.cs" Link="SettingsParse.cs" />
    <Compile Include="..\..\ClashUWP\Vpn\VpnPluginConfig.cs" Link="VpnPluginConfig.cs" />
  </ItemGroup>
</Project>
