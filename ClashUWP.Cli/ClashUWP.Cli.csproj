<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ClashUWP.Cli —— AppService 遥控端(桌面 full-trust 进程)。

    ★ 为什么客户端可以是普通控制台:
      AppService 的身份约束在<b>服务端</b>(必须打包并声明 uap:AppService)。
      客户端只要是 full-trust 桌面进程就能 OpenAsync —— 这正是 desktop bridge
      场景的设计;net10.0-windows TFM 自带 Windows SDK 投影,
      AppServiceConnection / PackageManager 直接用,不需要引 CsWinRT。

    ★ 为什么仍打成 MSIX(winapp package):
      有包身份后走 runFullTrust 桌面桥形态,连 AppService 的路径与未打包完全一致,
      但安装/卸载/签名有了正规通道。
      ★【1.0.89 · Docs/38 §十四 · 订正】这行原来写的是"且与主包同发布者(CN=gold)"——<b>现在不成立了</b>：
        主清单的 Publisher 已改成 <c>CN=A19C62A9-1AA6-44AB-9F57-2DE6C380D9C9</c>
        （现读 <c>ClashUWP\Package.appxmanifest:47</c>），本工程仍是 <c>CN=gold</c>
        （<c>ClashUWP.Cli\Package.appxmanifest:28</c>）。后果就是两个家族的发布者 hash 后缀<b>不同</b>：
        主包 <c>8B8CC4F4.ClashUWP_4tjvwvefxrz66</c>、本包 <c>ClashUWP.Cli_y0tg80em3rma2</c>。
        ★ 这条正是 F5 那个坑能活下来的原因之一：<c>AppServiceChannel</c> 里那份过期的主包身份
        <c>421769c5-…_y0tg80em3rma2</c> 后缀和本包一样，看上去"没漂"，其实主包早就改名换证了。
        跨包身份一律现查（<c>--list</c> / <c>doctor</c> 阶段1），不要照抄后缀。

    ★ 本工程不碰 VPN 隧道本身:它只是把一行命令发给主进程,
      命令语义与纪律(碰隧道的命令必须由人明确下发)与 debug-cmd 文件回路一致。
      1.0.2 起这条纪律落成了代码而不是注释:CommandCatalog 给每条命令标 read/state/tunnel,
      connect/recreate/probe 不带 force 开关会被本地拦下并返回退出码 7;
      disconnect 刻意不拦 —— 它是把网络还回去的逃生口。

    ★ 文件划分(1.0.2):Program.cs 只做路由,命令表 / 通道 / 探测 / guard / doctor / selftest
      各自成文件。理由很实在:以前命令清单只活在 Usage() 的一行字符串里,
      和主应用 DebugCommandLoop 的注释各说各话,不知道命令的人必须先读 app 源码才敢下发。
      现在 help、commands 的 json 输出、本地参数校验、危险闸门读同一张表。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>clashuwp-cli</AssemblyName>
    <RootNamespace>ClashUWP.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Version>1.0.4</Version>

    <!--
      ★ Native AOT —— 官方对"可执行文件/CLI"的推荐发布形态
        (Publishing native AOT apps / .NET 部署文档:启动快、免运行时依赖、体积小)。
      实测对照(2026-10-18,同一份源码):
        framework-dependent 布局 = 27 MB,其中 Microsoft.Windows.SDK.NET.dll 单文件 26 MB,
                                     且目标机必须装了 .NET 10 运行时才能跑;
        Native AOT              = clashuwp-cli.exe 单文件 4.17 MB,零运行时依赖。

      ★ AOT 会不会把 WinRT 投影跑挂?已用 selftest 命令(见 SelfTest.cs)实测:
        ValueSet 读写 / AppServiceConnection 构造与属性回读 / PackageManager 枚举(236 个包) /
        OpenAsync 异步跨 ABI 通路(不存在包→AppNotInstalled,干净返回) —— 4 项全 PASS。
        注:AOT 编译<b>通过</b>并不代表投影可用,这类泛型接口(IDictionary<string,object>)
        与 IAsyncOperation<T>.AsTask() 的投影是<b>运行时</b>才炸,所以自检命令要留着,
        别把它当一次性验证删掉。这里不需要像主工程那样引 CsWinRT 包 + 开 AllowUnsafeBlocks:
        本工程只用非泛型的 ValueSet/AppServiceConnection,net10.0-windows 自带的 SDK 投影够用。

      StripSymbols / DebugType=none:发布产物里不留 18 MB 的 pdb —— folder mode 打包
        是把布局目录整个塞进包,留着就等于把符号表打进可分发的 msix。
        Debug 配置仍然生成 pdb(排障要用)。
      RuntimeIdentifier 按 Platform 映射,让 `dotnet publish -c Release` 不带 -r 也能出 AOT。

      ★ 别把 CommandCatalog.JsonText() 改成 System.Text.Json 序列化对象:
        AOT 下反射式序列化要么裁剪告警要么运行时炸(source-gen 又要引包)。
        那张表就是一维数组,手写两个 StringBuilder 就出来了,而且零运行时风险。
    -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <RuntimeIdentifier Condition="'$(Platform)'=='arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)'=='x64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
