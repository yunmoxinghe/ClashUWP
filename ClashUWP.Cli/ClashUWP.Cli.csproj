<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ClashUWP.Cli —— AppService 遥控端(桌面 full-trust 进程)。

    ★ 为什么客户端可以是普通控制台:
      AppService 的身份约束在<b>服务端</b>(必须打包并声明 uap:AppService)。
      客户端只要是 full-trust 桌面进程就能 OpenAsync —— 这正是 desktop bridge
      场景的设计;net10.0-windows TFM 自带 Windows SDK 投影,
      AppServiceConnection / PackageManager 直接用,不需要引 CsWinRT。

    ★ 为什么仍打成 MSIX(winapp package):
      有包身份后走 runFullTrust 桌面桥形态,连 AppService 的路径与未打包完全一致,
      但安装/卸载/签名有了正规通道,且与主包同发布者(CN=gold)便于机器上识别。

    ★ 本工程不碰 VPN 隧道本身:它只是把一行命令发给主进程,
      命令语义与纪律(碰隧道的命令必须由人明确下发)与 debug-cmd 文件回路一致。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>clashuwp-cli</AssemblyName>
    <RootNamespace>ClashUWP.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Version>1.0.1</Version>

    <!--
      ★ Native AOT —— 官方对"可执行文件/CLI"的推荐发布形态
        (Publishing native AOT apps / .NET 部署文档:启动快、免运行时依赖、体积小)。
      实测对照(2026-10-18,同一份源码):
        framework-dependent 布局 = 27 MB,其中 Microsoft.Windows.SDK.NET.dll 单文件 26 MB,
                                     且目标机必须装了 .NET 10 运行时才能跑;
        Native AOT              = clashuwp-cli.exe 单文件 4.17 MB,零运行时依赖。

      ★ AOT 会不会把 WinRT 投影跑挂?已用 selftest 命令(见 Program.cs)实测:
        ValueSet 读写 / AppServiceConnection 构造与属性回读 / PackageManager 枚举(236 个包) /
        OpenAsync 异步跨 ABI 通路(不存在包→AppNotInstalled,干净返回) —— 4 项全 PASS。
        注:AOT 编译<b>通过</b>并不代表投影可用,这类泛型接口(IDictionary<string,object>)
        与 IAsyncOperation<T>.AsTask() 的投影是<b>运行时</b>才炸,所以自检命令要留着,
        别把它当一次性验证删掉。这里不需要像主工程那样引 CsWinRT 包 + 开 AllowUnsafeBlocks:
        本工程只用非泛型的 ValueSet/AppServiceConnection,net10.0-windows 自带的 SDK 投影够用。

      StripSymbols / DebugType=none:发布产物里不留 18 MB 的 pdb —— folder mode 打包
        是把布局目录整个塞进包,留着就等于把符号表打进可分发的 msix。
        Debug 配置仍然生成 pdb(排障要用)。
      RuntimeIdentifier 按 Platform 映射,让 `dotnet publish -c Release` 不带 -r 也能出 AOT。
    -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <RuntimeIdentifier Condition="'$(Platform)'=='arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)'=='x64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
