<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ClashUWP.Vpn —— CsWinRT 组件工程（后台任务的 WinRT 激活宿主）。

    ★ 为什么必须有这个工程：
      Package.appxmanifest 里 <uap:Task Type="vpnClient" /> 的 EntryPoint
      必须能在清单里对上一个可激活的 WinRT 类。平台侧是纯清单驱动的：
      它读 ActivatableClassId + Path，然后 LoadLibrary(Path) 再
      GetProcAddress("DllGetActivationFactory") —— 不查 winmd，也不认识托管 exe。

      直接把 VpnBackgroundTask 放在应用 exe 工程里，实测部署报：
        0x80080204 / 错误 0x80080204: 「如果不是音频后台任务，则不允许在
        windows.activatableClass.inProcessServer 中没有 ActivatableClassId 的情况下，
        令 EntryPoint="ClashUWP.Vpn.VpnBackgroundTask"」
      根因是 exe 工程不产出 winmd，平台找不到可激活类。

      CsWinRTComponent=true 让这个普通类库产出激活所需的元数据（.winmd）。
      ★ 本项目以「自包含组件」形态构建（PublishAot + NativeLib=Shared），CsWinRT 自动置
        CsWinRTAotExportsEnabled=true，让 ClashUWP.Vpn.dll 自身直接导出
        DllGetActivationFactory，不再产出、也不再需要 WinRT.Host.*。
        再由主工程 CsWinRTMergeReferencedActivationFactories 把它合并进主模块，
        清单 inProcessServer 的 Path 填主工程的 ClashUWP.dll（不是本组件的 dll）。
      （托管组件形态才需要 WinRT.Host.dll 宿主；更老 .NET Native 填 CLRHost.dll，均与
        本项目当前的全 AOT 形态无关。）

    两条静默规则（违反不会报错，只会产出空壳 winmd 或编译失败）：
      1. AssemblyName 必须等于或覆盖 RootNamespace —— 见下方注释。
      2. public 类型必须全部可 WinRT 投影。

    ★ 关于第 2 条的实际边界（实测出来的，不是一开始就想到的）：
      VpnPluginConfig 是 public 的，带 List&lt;string&gt; 属性和 static Parse()，
      实测 CsWinRT 能正常投影，没有报错。所以并没有必要为了它再单独拆一个
      普通类库工程 —— 前台 VpnProfileSetup 直接引用本工程的类型即可。
      真正必须 internal 化的只有 ClashVpnPlugin 和 IpPacket：
      前者平台不需要激活（由 VpnBackgroundTask 内部 new），
      后者只有前者用，两者都不该被投影。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- ★ 规则 1：类型在 namespace ClashUWP.Vpn，AssemblyName 必须等于它。
         若 AssemblyName 取成 ClashUWP 之外的名字（比如 ClashUWP.VpnTask），
         生成的 winmd 会是个 5120 字节的空壳，后续报
         CS0234: 命名空间"ABI"中不存在类型"ClashUWP.Vpn" —— 看起来像工具链坏了，
         其实是这条规则没满足。 -->
    <RootNamespace>ClashUWP.Vpn</RootNamespace>
    <AssemblyName>ClashUWP.Vpn</AssemblyName>
    <!-- 本地 feed 分发：每次插件代码变更需 bump 此版本并同步主工程 PackageReference，
         否则 NuGet 会命中全局缓存里的旧 nupkg（同版本号不重新拉取）。 -->
    <Version>1.0.25</Version>

    <CsWinRTComponent>true</CsWinRTComponent>
    <UseUwp>true</UseUwp>
    <Nullable>enable</Nullable>
    <!-- 缺这个会报 APPX1901：回退语言被设成 VS 的界面语言，不同机器上构建结果不一致。 -->
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- ★ CsWinRT「自包含组件」：与主工程一起 AOT，自身导出 DllGetActivationFactory。 -->
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>

    <!-- 同主工程：泛型 WinRT 接口（IVector<HostName>）跨 ABI 需要生成的 unsafe 代码。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>

</Project>
