<Solution>
  <!--
    只保留 x64 / arm64：各工程的 <Platforms> 都只声明了这两个
    （Reactor.Uwp 的原生桥 Reactor.Uwp.Native.dll 也只有这两个架构的预编译产物）。
    原先这里还映射了 x86，VS 选中 x86 时会因为工程不支持而部署失败。

    【1.0.76】插件工程 ClashUWP.Vpn 已回收进主工程 ⇒ 这里不再有它的节点。
    主工程自己就是 CsWinRT 授权组件（插件源码在 ClashUWP\Vpn\，命名空间不变）。
  -->
  <Configurations>
    <Platform Name="arm64" />
    <Platform Name="x64" />
  </Configurations>
  <Project Path="ClashUWP/ClashUWP.csproj">
    <Platform Solution="*|arm64" Project="arm64" />
    <Platform Solution="*|x64" Project="x64" />
    <Deploy />
  </Project>
  <!-- 遥控 CLI:纯桌面客户端,不参与 UWP 部署 -->
  <Project Path="ClashUWP.Cli/ClashUWP.Cli.csproj">
    <Platform Solution="*|arm64" Project="arm64" />
    <Platform Solution="*|x64" Project="x64" />
  </Project>
</Solution>
